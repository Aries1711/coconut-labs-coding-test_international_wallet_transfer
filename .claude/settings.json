{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-approval-before-commit.py\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking review approval (AGENTS.md step 5)"
          }
        ]
      }
    ]
  }
}
